# LLM Configuration
# Choose provider: openai or openrouter
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# OpenRouter Configuration (alternative to OpenAI)
# OpenRouter supports 150+ models from multiple providers
# Get API key: https://openrouter.io
# Common models:
#   - openai/gpt-3.5-turbo, openai/gpt-4
#   - anthropic/claude-3-5-sonnet, anthropic/claude-opus
#   - mistral/mistral-7b, mistral/mistral-medium
#   - meta-llama/llama-2-70b-chat
#   - google/palm-2-chat-bison
# To use OpenRouter, uncomment and set:
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=anthropic/claude-3-5-sonnet
