################################################################################
# LLM Chatbot Configuration
#
# This is the SINGLE source of truth for all environment variables.
# Copy this file to .env in the project root and fill in your values.
#
# Docker will automatically load this file via docker-compose.yml
# For local development, copy to the appropriate directory:
#   - Backend: cp .env backend/.env
#   - Frontend: cp .env frontend/.env
################################################################################

# ================================================================================
# LLM PROVIDER CONFIGURATION
# ================================================================================

# Choose LLM provider: openai or openrouter
LLM_PROVIDER=openai

# OpenAI Configuration
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# OpenRouter Configuration (alternative to OpenAI)
# Supports 150+ models from Anthropic, Mistral, Meta, Google, and more
# Get API key from: https://openrouter.ai/keys
# To use OpenRouter, uncomment below and set LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=anthropic/claude-3-5-sonnet

# Optional: OpenRouter Site Ranking Headers
# These help with model prioritization on openrouter.ai
# Uncomment if you have a site URL:
# YOUR_SITE_URL=https://your-site.com
# YOUR_SITE_NAME=Your Site Name

# ================================================================================
# CHATBOT BEHAVIOR CONFIGURATION
# ================================================================================

# System prompt template for the chatbot
# Available: default, technical_expert, creative_writer, teacher, business_consultant
# See backend/app/prompts.py for all available prompts and how to create custom ones
CHATBOT_PROMPT=default

# ================================================================================
# BACKEND CONFIGURATION
# ================================================================================

# Database Configuration
# Using SQLite by default (serverless, no setup needed)
# For production, you can change to PostgreSQL or MySQL
DATABASE_URL=sqlite:///./chatbot.db

# Server Configuration
BACKEND_PORT=8000

# Python Configuration
PYTHONUNBUFFERED=1

# ================================================================================
# FRONTEND CONFIGURATION
# ================================================================================

# Backend API URL
# For Docker: http://backend:8000 (uses service name from docker-compose)
# For Local Development: http://localhost:8000
REACT_APP_API_URL=http://localhost:8000
