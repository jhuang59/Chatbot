# LLM Configuration
# Choose provider: openai or openrouter
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# OpenRouter Configuration (alternative to OpenAI)
# Get your API key from https://openrouter.ai
# Common models: openai/gpt-3.5-turbo, anthropic/claude-3-5-sonnet, mistral/mistral-7b, meta-llama/llama-2-70b-chat, etc.
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=anthropic/claude-3-5-sonnet

# Optional: OpenRouter site ranking (improves model prioritization)
# YOUR_SITE_URL=https://your-site.com
# YOUR_SITE_NAME=Your Site Name

# Chatbot Behavior
# Choose a prompt template: default, technical_expert, creative_writer, teacher, business_consultant
# See app/prompts.py for available prompts
CHATBOT_PROMPT=default

# Database Configuration
DATABASE_URL=sqlite:///./chatbot.db

# Server Configuration
BACKEND_PORT=8000
PYTHONUNBUFFERED=1
